assert_contains "$search_css" '.search-filter-toggle[aria-expanded="true"] .search-filter-toggle-icon::before' "filter chevrons must flip when open"
assert_contains "$search_css" "[data-search-page-submit]" "Search button must keep the highlighted action styling"
assert_not_contains "$search_css" ".$pending_token" "draft state must not render a separate pending status style"
assert_contains "$search_css" ".search-result-link:hover *" "result hover must suppress broad underline styling"
assert_contains "$search_css" ".search-result-link:hover .search-result-title" "result hover must underline only the title"
assert_contains "$search_css" "max-height: 70vh" "search results must use a vertical scroll container"
assert_contains "$search_page" "let draftState = null" "full search page must keep draft state separate from committed state"
assert_not_contains "$search_page" "renderLoadingFilterControls(filterMount)" "full search page must keep initial loading shells in the template"
assert_contains "$search_page" "sortControl.disabled = true" "sort control must be disabled while Pagefind filter data loads"
assert_contains "$search_page" "pendingSearchSubmit" "full search page must capture Search submissions before hydration"
assert_contains "$search_page" "loadingQueryEdited" "full search page must preserve query edits made before hydration"
assert_contains "$search_page" 'new URLSearchParams(window.location.search).get("q")' "full search page may prefill q before filter hydration without parsing filters"
assert_contains "$search_page" "commitDraftSearch" "full search page must commit query and filters through the Search action"
assert_contains "$search_page" "filterControls?.commitOpen()" "Search action must accept any open staged dropdown before committing"
assert_contains "$search_page" "hasActiveSearchState(committedState)" "sort actions must operate on committed active searches"
assert_not_contains "$search_page" "commitFilters" "filter changes must not immediately commit URL/search state"


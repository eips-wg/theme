storage_token='local''Storage'
pending_token='search-page-''pending'

command -v "$zola" >/dev/null 2>&1 || die "zola is required on PATH"
command -v "$pagefind" >/dev/null 2>&1 || die "pagefind is required on PATH"
command -v "$node" >/dev/null 2>&1 || die "node is required on PATH"

tmp_root=$(mktemp -d "${TMPDIR:-/tmp}/eips-theme-pagefind-ui.XXXXXX")
trap 'rm -rf "$tmp_root"' EXIT INT HUP TERM

for source_file in \
    "$search_script" \
    "$search_constants" \
    "$search_config" \
    "$search_loader" \
    "$search_dom" \
    "$search_render" \
    "$search_page" \
    "$search_modal" \
    "$search_filters" \
    "$search_state"
do
    assert_not_contains "$source_file" "fuse.js" "Phase 6 search modules must not load Fuse"
    assert_not_contains "$source_file" "window.Fuse" "Phase 6 search modules must not reference Fuse"
    assert_not_contains "$source_file" "atom.xml" "Phase 6 search modules must not depend on Atom XML search data"
    assert_not_contains "$source_file" "$storage_token" "Phase 6 must not read or write browser storage"
    assert_not_contains "$source_file" 'document.createElement("style")' "search modules must not inject runtime CSS"
    assert_not_contains "$source_file" "document.head.appendChild(style)" "search modules must not append runtime CSS"
    assert_not_contains "$source_file" "addSearchStyles" "search modules must not keep runtime CSS injection hooks"
done

for source_file in \
    "$search_script" \
    "$search_constants" \
    "$search_config" \
    "$search_dom" \
    "$search_page" \
    "$search_modal" \
    "$search_filters" \
    "$search_state"
do
    assert_not_contains "$source_file" "pagefind.js" "Pagefind browser import must stay inside loader.mjs"
    assert_not_contains "$source_file" "pagefind.search" "Pagefind search calls must stay inside loader.mjs"
    assert_not_contains "$source_file" "pagefind.filters" "Pagefind filter calls must stay inside loader.mjs"
    assert_not_contains "$source_file" "pagefind.init" "Pagefind init calls must stay inside loader.mjs"
    assert_not_contains "$source_file" "pagefind.options" "Pagefind options calls must stay inside loader.mjs"
    assert_not_contains "$source_file" "innerHTML" "Only render.mjs may use innerHTML for Pagefind excerpts"
done

assert_contains "$search_script" 'import { initQuickSearch } from "./search/modal.mjs";' "public search entrypoint must import quick search initializer"
assert_contains "$search_script" 'import { initFullSearchPage } from "./search/page.mjs";' "public search entrypoint must import full search initializer"
assert_contains "$search_loader" 'import(`${bundlePath}pagefind.js`)' "loader module must dynamically import the configured Pagefind bundle"
assert_contains "$search_loader" "basePath: bundlePath" "loader module must pass Pagefind basePath"
assert_contains "$search_loader" "baseUrl: searchConfig.base_path" "loader module must pass Pagefind baseUrl"
assert_contains "$search_loader" "excerptLength: 45" "loader module must configure Pagefind excerpt length"
assert_contains "$search_loader" "pagefind.init()" "loader module must initialize Pagefind once through the shared loader"
assert_contains "$search_loader" "pagefind.filters()" "loader module must expose Pagefind filter loading"
assert_contains "$search_loader" "pagefind.search(query, searchOptions)" "loader module must own Pagefind search execution"
assert_contains "$search_render" "excerpt.innerHTML = data.excerpt" "render module must render Pagefind excerpt highlights"
assert_contains "$search_constants" '"number-asc": { number: "asc" }' "sort constants must define proposal number ascending sort"
assert_contains "$search_constants" '"created-desc": { created: "desc" }' "sort constants must define created date descending sort"
assert_contains "$search_modal" "Quick Search Proposals" "quick search modal must use the final heading"
assert_contains "$search_modal" "Enter keyword or phrase" "quick search modal must use keyword/phrase placeholder copy"
assert_contains "$search_constants" 'key: "author"' "filter constants must define the author field"
assert_contains "$search_state" "AUTHOR_MODE_PARAM" "state module must own author mode URL state"
assert_contains "$search_state" "pagefindFilters.author = values" "state module must encode author AND filters as arrays"
assert_contains "$search_filters" 'role: "combobox"' "filter module must render custom combobox controls"
assert_contains "$search_filters" 'aria-label": `Remove ${filterLabel(field.key).toLowerCase()} ${value}`' "filter chips must have specific accessible remove labels"
assert_contains "$search_filters" 'class: "search-filter-toggle-icon"' "filter toggles must use the chevron icon hook"
assert_contains "$search_filters" '"Choose operator"' "author filter must label the operator control"
assert_contains "$search_filters" '"And"' "author filter must expose the AND operator label"
assert_contains "$search_filters" '"Or"' "author filter must expose the OR operator label"
assert_not_contains "$search_filters" "Any author" "author operator labels must stay concise"
assert_not_contains "$search_filters" "All authors" "author operator labels must stay concise"
assert_contains "$search_css" "max-height: min(50vh, 28rem)" "filter dropdowns must be capped around 50vh"
assert_contains "$search_css" "top: 4.6rem" "filter dropdowns must keep a stable overlay position"
assert_contains "$search_css" '.search-filter-toggle[aria-expanded="true"] .search-filter-toggle-icon::before' "filter chevrons must flip when open"
assert_contains "$search_css" ".search-result-link:hover *" "result hover must suppress broad underline styling"
assert_contains "$search_css" ".search-result-link:hover .search-result-title" "result hover must underline only the title"
assert_contains "$search_css" "max-height: 70vh" "search results must use a vertical scroll container"
assert_contains "$search_css" '.search-share-button[data-share-state="success"]' "share button must expose success state styling"
assert_contains "$search_css" '.search-share-button[data-share-state="error"]' "share button must expose error state styling"
assert_contains "$search_page" "SHARE_SUCCESS_RESET_MS" "share button success state must reset after a short delay"
assert_contains "$search_page" "shareButton.dataset.shareState" "share button state must be controlled by page script"
assert_contains "$search_share_svg" '<symbol id="search-share"' "share icon asset must expose the search-share symbol"
assert_contains "$search_share_svg" 'currentColor' "share icon asset must inherit button color"
assert_contains "$search_constants" 'PROPOSAL_CATEGORY_KEY = "proposalCategory"' "filter constants must define the proposalCategory URL key"
assert_contains "$search_constants" 'PROPOSAL_CATEGORY_FIELD = "proposal_category"' "filter constants must define the proposal_category Pagefind field"
assert_contains "$search_constants" 'label: "Proposal Category"' "filter constants must define the Proposal Category field"
assert_not_contains "$search_constants" 'key: "prefix"' "prefix must not remain a visible filter field"
assert_not_contains "$search_constants" 'key: "type"' "type must not remain a visible filter field"
assert_not_contains "$search_constants" 'key: "category"' "category must not remain a visible filter field"
assert_contains "$search_constants" 'key: "author"' "filter constants must define the author field"
assert_contains "$search_constants" 'CREATED_YEAR_FIELD = "created_year"' "filter constants must define the created year Pagefind field"
assert_contains "$search_constants" 'CREATED_FROM_PARAM = "createdFrom"' "filter constants must define the createdFrom URL parameter"
assert_contains "$search_constants" 'CREATED_TO_PARAM = "createdTo"' "filter constants must define the createdTo URL parameter"
assert_contains "$search_state" "AUTHOR_MODE_PARAM" "state module must own author mode URL state"
assert_contains "$search_state" "pagefindFilters.author = values" "state module must encode author AND filters as arrays"
assert_contains "$search_state" "filterUrlParam(field)" "state module must use field-specific URL parameter names"
assert_contains "$search_state" "filterPagefindField(field)" "state module must use field-specific Pagefind filter names"
assert_contains "$search_state" "pagefindFilters[filterPagefindField(field)]" "state module must encode Proposal Category using the Pagefind field name"
assert_contains "$search_state" "CREATED_FROM_PARAM" "state module must own createdFrom URL state"
assert_contains "$search_state" "CREATED_TO_PARAM" "state module must own createdTo URL state"
assert_contains "$search_state" "pagefindFilters[CREATED_YEAR_FIELD] = { any: createdYears }" "state module must encode created year filters as Pagefind OR filters"
assert_contains "$search_state" "for (let year = from; year <= to; year += 1)" "state module must expand created year ranges inclusively"
assert_contains "$search_state" "pushSearchStateIfNeeded" "state module must avoid duplicate clean-route history entries"
assert_contains "$search_filters" 'role: "combobox"' "filter module must render custom combobox controls"
assert_contains "$search_template" "search-filter-grid-loading" "search template must render loading filter shells before JS starts"

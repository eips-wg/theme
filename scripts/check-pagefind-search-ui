#!/bin/sh
set -eu

die() {
    printf 'error: %s\n' "$*" >&2
    exit 1
}

say() {
    printf '%s\n' "$*"
}

assert_contains() {
    file=$1
    expected=$2
    message=$3

    if ! grep -Fq "$expected" "$file"; then
        die "$message"
    fi
}

assert_not_contains() {
    file=$1
    unexpected=$2
    message=$3

    if grep -Fq "$unexpected" "$file"; then
        die "$message"
    fi
}

assert_matches() {
    file=$1
    expected_pattern=$2
    message=$3

    if ! grep -Eq "$expected_pattern" "$file"; then
        die "$message"
    fi
}

assert_pagefind_artifact() {
    path_pattern=$1
    message=$2

    if ! find "$pagefind_dir" -path "$path_pattern" -type f | grep -q .; then
        die "$message"
    fi
}

author_details_for() {
    name=$1

    case "$name" in
        Alice)
            printf '[[extra.author_details]]\nname = "Alice"\nemail = "alice@example.com"\ndisplay = "Alice <alice@example.com>"\n'
            ;;
        Bob)
            printf '[[extra.author_details]]\nname = "Bob"\ngithub = "bob"\ndisplay = "Bob (@bob)"\n'
            ;;
        Carol)
            printf '[[extra.author_details]]\nname = "Carol"\ngithub = "carol"\nemail = "carol@example.com"\ndisplay = "Carol (@carol) <carol@example.com>"\n'
            ;;
        Dan)
            printf '[[extra.author_details]]\nname = "Dan"\ndisplay = "Dan"\n'
            ;;
    esac
}

write_proposal() {
    project_dir=$1
    number=$2

    file=$(printf '%05d.md' "$number")
    day=$(printf '%02d' "$number")
    year=$((2021 + ((number - 1) % 5)))
    slug=$number

    case $((number % 3)) in
        1)
            status=Draft
            ;;
        2)
            status=Review
            ;;
        *)
            status=Final
            ;;
    esac

    prefix=EIP
    category=
    case $(((number - 1) % 6)) in
        0)
            type="Standards Track"
            category=Core
            ;;
        1)
            type="Standards Track"
            category=Networking
            ;;
        2)
            type="Standards Track"
            category=Interface
            ;;
        3)
            type="Meta"
            ;;
        4)
            type="Informational"
            ;;
        *)
            prefix=ERC
            type="Standards Track"
            category=Core
            ;;
    esac

    proposal_id=$prefix-$number
    category_taxonomy=
    category_extra=
    if [ -n "$category" ]; then
        category_taxonomy="category = [\"$category\"]"
        category_extra="category = \"$category\""
    fi
    authors_toml=
    author_details=
    for author in Alice Bob Carol Dan; do
        include=false
        case "$author" in
            Alice)
                [ $((number % 2)) -eq 1 ] && include=true
                ;;
            Bob)
                [ $((number % 2)) -eq 0 ] && include=true
                ;;
            Carol)
                [ $((number % 3)) -eq 0 ] && include=true
                ;;
            Dan)
                [ $((number % 4)) -eq 0 ] && include=true
                ;;
        esac
        if [ "$include" = true ]; then
            if [ -n "$authors_toml" ]; then
                authors_toml="$authors_toml, "
            fi
            authors_toml="${authors_toml}\"$author\""
            author_details="${author_details}$(author_details_for "$author")
"
        fi
    done

    cat >"$project_dir/content/$file" <<EOF
+++
title = "Phase Six Proposal $number"
description = "Phase Six Proposal $number description."
date = $year-01-$day
slug = "$slug"
authors = [$authors_toml]
template = "eip.html"

[taxonomies]
status = ["$status"]
type = ["$type"]
$category_taxonomy

[extra]
proposal_id = "$proposal_id"
prefix = "$prefix"
number = $number
status = "$status"
type = "$type"
$category_extra
discussions_to = ""
requires = []
withdrawal_reason = ""
$author_details
+++

## Abstract

PhaseSixBodyMarker

## Motivation

This proposal should appear in Pagefind UI results.
EOF
}

write_fixture_project() {
    project_dir=$1
    base_url=$2
    compile_sass=${3:-false}
    proposal_count=${4:-1}

    mkdir -p "$project_dir/content" "$project_dir/themes"
    ln -s "$theme_root" "$project_dir/themes/eips-theme"

    cat >"$project_dir/config.toml" <<EOF
base_url = "$base_url"
title = "Pagefind Search UI Fixture"
description = "Pagefind search UI fixture"
theme = "eips-theme"
compile_sass = $compile_sass
build_search_index = false
generate_feeds = false
taxonomies = [
    { name = "status" },
    { name = "category" },
    { name = "type" },
]

[extra.github]
eip_repository = "https://github.com/example/eips"

[extra.taxonomies.status.draft]
tooltip = "Draft"

[extra.taxonomies.status.review]
tooltip = "Review"

[extra.taxonomies.status.final]
tooltip = "Final"

[extra.taxonomies.category.core]
tooltip = "Core"

[extra.taxonomies.category.erc]
tooltip = "ERC"

[extra.taxonomies.category.networking]
tooltip = "Networking"

[extra.taxonomies.category.interface]
tooltip = "Interface"

[extra.taxonomies.type.standards-track]
tooltip = "Standards Track"

[extra.taxonomies.type.meta]
tooltip = "Meta"

[extra.taxonomies.type.informational]
tooltip = "Informational"
EOF

    cat >"$project_dir/content/_index.md" <<'EOF'
+++
title = "Home"
+++

# Home

UniqueHomeMarker
EOF

    cat >"$project_dir/content/search.md" <<'EOF'
+++
title = "Search"
template = "search.html"
+++

UniqueSearchMarker
EOF

    proposal_number=1
    while [ "$proposal_number" -le "$proposal_count" ]; do
        write_proposal "$project_dir" "$proposal_number"
        proposal_number=$((proposal_number + 1))
    done
}

build_fixture_project() {
    project_dir=$1
    output_dir=$2

    (cd "$project_dir" && "$zola" build --force -o "$output_dir" >/dev/null)
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
theme_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
zola=${ZOLA:-zola}
pagefind=${PAGEFIND:-pagefind}
node=${NODE:-node}
search_script=$theme_root/static/assets/scripts/search.mjs
search_modules_dir=$theme_root/static/assets/scripts/search
search_constants=$search_modules_dir/constants.mjs
search_config=$search_modules_dir/config.mjs
search_loader=$search_modules_dir/loader.mjs
search_dom=$search_modules_dir/dom.mjs
search_render=$search_modules_dir/render.mjs
search_page=$search_modules_dir/page.mjs
search_modal=$search_modules_dir/modal.mjs
search_filters=$search_modules_dir/filters.mjs
search_state=$search_modules_dir/state.mjs
search_css=$theme_root/sass/assets/css/search.scss
search_share_svg=$theme_root/static/assets/images/search-share.svg

disabled_output=$tmp_root/disabled-output
write_fixture_project "$disabled_project" "https://example.test/" false 1
build_fixture_project "$disabled_project" "$disabled_output"
disabled_html=$disabled_output/search/index.html
[ -f "$disabled_html" ] || die "disabled fixture did not render /search/"
assert_contains "$disabled_html" 'id="search-page-query"' "disabled search page must render query input"
assert_contains "$disabled_html" 'data-search-page-filters' "disabled search page must render filter mount"
assert_not_contains "$disabled_html" "data-$pending_token" "disabled search page must not render pending-change status mount"
assert_contains "$disabled_html" 'Search is not available for this build.' "disabled search page must show disabled message"
assert_contains "$disabled_html" '"enabled":false' "disabled search config must render enabled=false"
assert_not_contains "$disabled_html" '"bundle_path"' "disabled search config must omit bundle_path"
assert_contains "$disabled_html" 'data-search-share hidden' "disabled search page must not show share action"
assert_not_contains "$disabled_html" "pagefind.js" "disabled search page must not import Pagefind browser assets"

enabled_project=$tmp_root/enabled-project
enabled_output=$tmp_root/enabled-output
write_fixture_project "$enabled_project" "https://example.test/EIPs/" true 30
mkdir -p "$enabled_project/data"
cat >"$enabled_project/data/build_eips_search.toml" <<'EOF'
enabled = true
base_path = "/EIPs/"
bundle_path = "/EIPs/pagefind/"
EOF
build_fixture_project "$enabled_project" "$enabled_output"

search_html=$enabled_output/search/index.html
proposal_html=$enabled_output/1/index.html
home_html=$enabled_output/index.html
[ -f "$search_html" ] || die "enabled fixture did not render /search/"
[ -f "$proposal_html" ] || die "enabled fixture did not render /1/"
[ -f "$home_html" ] || die "enabled fixture did not render home"

assert_contains "$search_html" 'id="search-page-query"' "enabled search page must render query input"
assert_contains "$search_html" 'id="search-page-sort"' "enabled search page must render sort control"
assert_contains "$search_html" 'data-search-page-filters' "enabled search page must render filter mount"
assert_contains "$search_html" 'search-filter-grid-loading' "enabled search page must render filter loading shells in initial HTML"
assert_contains "$search_html" 'data-search-filter-field="proposalCategory"' "enabled search page must render Proposal Category loading shell"
assert_contains "$search_html" 'data-search-filter-field="status"' "enabled search page must render Status loading shell"
assert_contains "$search_html" 'data-search-filter-field="author"' "enabled search page must render Author loading shell"
assert_contains "$search_html" 'data-search-filter-field="created_year"' "enabled search page must render Created Date loading shell"
assert_contains "$search_html" 'Loading values...' "enabled search page loading shells must avoid fake counts"
assert_not_contains "$search_html" "data-$pending_token" "enabled search page must not render pending-change status mount"
assert_contains "$search_html" 'value="number-asc"' "enabled search page must expose number ascending sort"
assert_contains "$search_html" 'value="created-desc"' "enabled search page must expose created descending sort"
assert_contains "$search_html" 'data-search-share' "enabled search page must render share action"
assert_not_contains "$search_html" 'data-search-share hidden' "enabled search page must keep share action visible by default"
assert_contains "$search_html" 'data-bs-trigger="hover"' "share tooltip must be hover-triggered"
assert_contains "$search_html" 'search-share.svg' "share action must render the share icon asset"
assert_contains "$search_html" 'assets/css/search.css' "enabled pages must link the compiled search stylesheet"
assert_contains "$search_html" '"enabled":true' "enabled search config must render enabled=true"
assert_contains "$search_html" '"base_path":"/EIPs/"' "enabled search config must preserve subpath base_path"
assert_contains "$search_html" '"bundle_path":"/EIPs/pagefind/"' "enabled search config must preserve subpath bundle_path"
assert_matches "$search_html" 'id="search" href="(&#x2F;|/)EIPs(&#x2F;|/)search(&#x2F;|/)" data-search-trigger' "global search trigger must link to the generated search route"
assert_not_contains "$search_html" "pagefind.js" "enabled search page must not statically import Pagefind browser assets"
[ -f "$enabled_output/assets/css/search.css" ] || die "enabled fixture must compile search Sass to assets/css/search.css"

assert_contains "$proposal_html" 'data-pagefind-meta="proposal:EIP-1"' "proposal metadata must come from page.extra.proposal_id"
assert_contains "$proposal_html" 'data-pagefind-meta="title[data-pagefind-value]" data-pagefind-value="EIP-1: Phase Six Proposal 1"' "proposal title metadata must use canonical proposal id"
assert_contains "$proposal_html" 'data-pagefind-filter="proposal_category:Core"' "proposal page must expose the derived proposal category filter"
assert_not_contains "$proposal_html" 'data-pagefind-filter="prefix:' "proposal page must not expose prefix as a filter"
assert_not_contains "$proposal_html" 'data-pagefind-filter="type:' "proposal page must not expose type as a filter"
assert_not_contains "$proposal_html" 'data-pagefind-filter="category:' "proposal page must not expose category as a filter"
assert_contains "$proposal_html" 'data-pagefind-filter="created_year:2021"' "proposal page must expose the created year filter"
assert_not_contains "$home_html" 'data-pagefind-body' "home must remain unindexed"
assert_not_contains "$search_html" 'data-pagefind-body' "search route must remain unindexed"
if grep -R 'data-pagefind-filter="\(prefix\|type\|category\):' "$enabled_output" >/dev/null; then
    die "prefix, type, and category must not render as Pagefind filters"
fi
if grep -R 'data-pagefind-filter="proposal_category:Other"' "$enabled_output" >/dev/null; then
    die "proposal_category must not render Other"
fi
for standards_track_html in $(grep -Rl 'data-pagefind-meta="type:Standards Track"' "$enabled_output" || true); do
    proposal_category_count=$(
        grep -Eo 'data-pagefind-filter="proposal_category:(ERC|Core|Networking|Interface|Meta|Informational)"' "$standards_track_html" \
            | wc -l \
            | tr -d ' '
    )
    if [ "$proposal_category_count" != "1" ]; then
        die "Standards Track fixture page must render exactly one valid proposal_category filter: $standards_track_html"
    fi
done

pagefind_log=$tmp_root/pagefind.log
"$pagefind" --site "$enabled_output" --output-subdir pagefind --force-language en --verbose >"$pagefind_log" 2>&1
pagefind_dir=$enabled_output/pagefind
[ -f "$pagefind_dir/pagefind.js" ] || die "Pagefind must write pagefind.js"
[ -f "$pagefind_dir/pagefind-entry.json" ] || die "Pagefind must write pagefind-entry.json"
assert_pagefind_artifact "$pagefind_dir/*.pf_meta" "Pagefind must write metadata artifacts"
assert_pagefind_artifact "$pagefind_dir/index/*.pf_index" "Pagefind must write index artifacts"
assert_contains "$pagefind_log" 'Indexed 30 pages' "Pagefind must index only the 30 proposal pages"

SITE="$enabled_output" "$node" --input-type=module <<'NODE'
import { readFile } from "node:fs/promises";

const site = process.env.SITE;

function fail(message) {
  console.error(`error: ${message}`);
  process.exit(1);
}

function assert(condition, message) {
  if (!condition) {
    fail(message);
  }
}

globalThis.fetch = async (url) => {
  const data = await readFile(new URL(String(url)));
  return {
    arrayBuffer: async () =>
      data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength),
    json: async () => JSON.parse(data.toString("utf8")),
  };
};

const pagefind = await import(`file://${site}/pagefind/pagefind.js`);
await pagefind.options({
  basePath: `file://${site}/pagefind/`,
  baseUrl: "/EIPs/",
  excerptLength: 45,
});
await pagefind.init();

const filters = await pagefind.filters();
assert(!("prefix" in filters), "prefix must not be a Pagefind filter field");
assert(!("type" in filters), "type must not be a Pagefind filter field");
assert(!("category" in filters), "category must not be a Pagefind filter field");
const allowedProposalCategories = ["ERC", "Core", "Networking", "Interface", "Meta", "Informational"];
assert(filters.proposal_category !== undefined, "proposal_category should come from Pagefind filters");
for (const value of allowedProposalCategories) {
  assert(filters.proposal_category[value] === 5, `proposal_category ${value} count should come from Pagefind filters`);
}
for (const value of Object.keys(filters.proposal_category)) {
  assert(allowedProposalCategories.includes(value), `unexpected proposal_category filter value ${value}`);
}
assert(!("Other" in filters.proposal_category), "proposal_category must not expose Other");
assert(filters.status.Draft === 10, "status Draft count should come from Pagefind filters");
assert(filters.status.Review === 10, "status Review count should come from Pagefind filters");
assert(filters.status.Final === 10, "status Final count should come from Pagefind filters");
assert(filters.created_year["2021"] === 6, "created year 2021 count should come from Pagefind filters");
assert(filters.created_year["2022"] === 6, "created year 2022 count should come from Pagefind filters");
assert(filters.created_year["2023"] === 6, "created year 2023 count should come from Pagefind filters");
assert(filters.created_year["2024"] === 6, "created year 2024 count should come from Pagefind filters");
assert(filters.created_year["2025"] === 6, "created year 2025 count should come from Pagefind filters");
assert(filters.author.Alice === 15, "author Alice count should come from Pagefind filters");
assert(filters.author.Bob === 15, "author Bob count should come from Pagefind filters");
assert(filters.author.Carol === 10, "author Carol count should come from Pagefind filters");
assert(filters.author.Dan === 7, "author Dan count should come from Pagefind filters");

const allResults = await pagefind.search("PhaseSixBodyMarker", {
  sort: { number: "asc" },
});
assert(allResults.results.length === 30, "query should find all 30 proposals");
const first = await allResults.results[0].data();
assert(first.url === "/EIPs/1/", "Pagefind result URL should preserve subpath baseUrl");
assert(first.meta.proposal === "EIP-1", "proposal metadata should survive indexing");
assert(first.meta.title === "EIP-1: Phase Six Proposal 1", "title metadata should survive indexing");
assert(first.meta.status === "Draft", "status metadata should survive indexing");
assert(first.meta.type === "Standards Track", "type metadata should survive indexing");
assert(first.meta.category === "Core", "category metadata should survive indexing");
assert(first.meta.created === "2021-01-01", "created metadata should survive indexing");
assert(first.meta.authors.includes("Alice <alice@example.com>"), "authors metadata should include display values");
assert(first.excerpt.includes("PhaseSixBodyMarker"), "Pagefind result should include highlighted excerpt text");

const filterOnly = await pagefind.search(null, {
  filters: { status: { any: ["Draft"] } },
});
assert(filterOnly.results.length === 10, "filter-only search should use null query and status filter");

const statusAny = await pagefind.search(null, {
  filters: { status: { any: ["Draft", "Review"] } },
});
assert(statusAny.results.length === 20, "single-value fields should encode multiple values as OR");

const authorAll = await pagefind.search(null, {
  filters: { author: ["Alice", "Carol"] },
});
assert(authorAll.results.length === 5, "author all mode should encode AND as an array");

const authorAny = await pagefind.search(null, {
  filters: { author: { any: ["Alice", "Carol"] } },
});
assert(authorAny.results.length === 20, "author any mode should encode OR with any");

const proposalCategorySorted = await pagefind.search(null, {
  filters: { proposal_category: { any: ["Core"] } },
  sort: { number: "desc" },
});
assert(proposalCategorySorted.results.length === 5, "proposal category filter should support sorted filter-only search");
const [highestCore] = await Promise.all(proposalCategorySorted.results.slice(0, 1).map((result) => result.data()));
assert(highestCore.meta.proposal === "EIP-25", "sorted proposal category search should preserve sort order");

const createdSingle = await pagefind.search(null, {
  filters: { created_year: { any: ["2021"] } },
});
assert(createdSingle.results.length === 6, "created year single filter should find matching proposals");

const createdRange = await pagefind.search(null, {
  filters: { created_year: { any: ["2021", "2022", "2023"] } },
});
assert(createdRange.results.length === 18, "created year range filter should expand to inclusive OR years");

for (const [term, label] of [
  ["UniqueSearchMarker", "/search/"],
  ["UniqueHomeMarker", "home"],
]) {
  const absent = await pagefind.search(term);
  assert(absent.results.length === 0, `${label} should not be indexed`);
}

console.log(JSON.stringify({
  filterFields: Object.keys(filters).sort(),
  resultCounts: {
    all: allResults.results.length,
    filterOnlyDraft: filterOnly.results.length,
    statusAnyDraftReview: statusAny.results.length,
    authorAllAliceCarol: authorAll.results.length,
    authorAnyAliceCarol: authorAny.results.length,
    proposalCategoryCore: proposalCategorySorted.results.length,
    createdYear2021: createdSingle.results.length,
    createdYear2021To2023: createdRange.results.length,
  },
}));
NODE

say "Pagefind search UI checks passed"
